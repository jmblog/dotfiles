        "~/.config/heroku",
        "~/.config/vercel",
        "~/.config/netlify",
        "~/.config/firebase",
        "~/.config/stripe",
        "~/.config/twilio",
        "~/.config/circleci",
        "~/.pulumi/credentials.json",
        "~/.sentryclirc",
        "~/.config/snyk",
        "~/.sup",
        "~/.config/helm",

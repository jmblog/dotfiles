      ]
    },
    "excludedCommands": [
      "git:*",
      "gh:*",
      "gcloud:*",
      "docker:*",
      "bq:*"
    ]
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false,
  "teammateDefaultModel": "sonnet",
  "model": "claude-fable-5-1[1m]"

      }
    },
    "ubie-plugins": {
      "source": {
        "source": "github",
        "repo": "ubie-inc/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com"
      ],
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "//tmp/claude-work",
        "~/.npm",
        "~/.cache",
        "~/.agent-browser",
        "~/Library/Caches/go-build",
        "~/Library/Caches/ms-playwright",
        "~/.crit"
      ],
      "denyWrite": [
        "//etc",
        "//usr",
        "//bin",
        "//sbin",
        "//opt",
        "//var",
        "//System",
        "//Library",

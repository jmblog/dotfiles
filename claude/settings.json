{
  "env": {
    "DISABLE_MICROCOMPACT": "true",
    "ENABLE_TOOL_RESEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(awk *)",
      "Bash(python* *)",
      "Bash(jq *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git remote -v *)",
      "Bash(git stash *)",
      "Bash(git add:*)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git revert:*)",
      "Bash(gh pr:*)",
      "Bash(npm run *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(tsc *)",
      "Bash(vitest *)",
      "Bash(prettier *)",
      "Bash(eslint *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(ps *)",
      "Bash(lsof *)",
      "Bash(mise *)",
      "Bash(npx tsc *)",
      "WebFetch(domain:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(*/python* *)",
      "Bash(*/node *)",
      "Bash(node *)",
      "Bash(bash *)",
      "Bash(*/bash *)",
      "Bash(sh *)",
      "Bash(*/sh *)",
      "Bash(zsh *)",
      "Bash(*/zsh *)",
      "Bash(csh *)",
      "Bash(*/csh *)",
      "Bash(tcsh *)",
      "Bash(*/tcsh *)",
      "Bash(ksh *)",
      "Bash(*/ksh *)",
      "Bash(fish *)",
      "Bash(*/fish *)",
      "Bash(dash *)",
      "Bash(*/dash *)",
      "Bash(go run *)",
      "Bash(*/go run *)",
      "Bash(curl *)",
      "Bash(*/curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git -C *)",
      "Bash(chmod *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'",
            "timeout": 86400
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/control-room/delegation_hook.py' || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit(**)",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ $FILE == *.ts || $FILE == *.tsx ]]; then npx tsc --noEmit $FILE; fi"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/control-room/delegation_hook.py' || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.dotfiles/claude/scripts/sync-agent-skills.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/control-room/delegation_hook.py' || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/control-room/delegation_hook.py' || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/control-room/delegation_hook.py' || true",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/jimbo/.claude/hooks/claude-island-state.py'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "compact-plus@compact-plus-local": true,
    "crit@crit": true,
    "dpc-monthly-report@ubie-plugins": true,
    "dpc-oracle@dpc-oracle": true,
    "frontend-design@claude-plugins-official": true,
    "lightdash-jp-mis-dwh-content-developer@ubie-plugins": true,
    "mocks@ubie-plugins": true,
    "slide-banana@ubie-plugins": true,
    "superpowers@claude-plugins-official": true,
    "superpowers@superpowers-dev": false,
    "swift-lsp@claude-plugins-official": false,
    "ubie-basics@ubie-plugins": true,
    "sf@ubie-plugins": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "compact-plus-local": {
      "source": {
        "source": "github",
        "repo": "u-ichi/compact-plus"
